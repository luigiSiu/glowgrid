<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>Glowgrid</string>

    <key>CFBundleDisplayName</key>
    <string>Glowgrid</string>

    <key>CFBundleIdentifier</key>
    <string>dev.luigisiu.glowgrid</string>

    <key>CFBundleExecutable</key>
    <string>Glowgrid</string>

    <!--
        Only seen in Finder, Get Info and Time Machine. The menu bar shows an
        SF Symbol chosen at runtime to match the current status, which is a
        separate thing entirely and deliberately not this icon.
    -->
    <key>CFBundleIconFile</key>
    <string>AppIcon</string>

    <key>CFBundlePackageType</key>
    <string>APPL</string>

    <key>CFBundleShortVersionString</key>
    <string>0.1.0</string>

    <key>CFBundleVersion</key>
    <string>1</string>

    <key>LSMinimumSystemVersion</key>
    <string>13.0</string>

    <!--
        Menu bar only: no Dock icon, no app switcher entry, no main window.
        Without this the app would behave like a normal windowed application.
    -->
    <key>LSUIElement</key>
    <true/>

    <!--
        Required for CoreBluetooth. macOS shows this string when it asks for
        permission the first time.

        This is precisely what the Python CLI lacked: a plain script is not a
        bundle, so it cannot declare a usage description, and macOS kills the
        process with SIGABRT instead of prompting. As a proper bundle we get a
        normal prompt once and it is remembered.
    -->
    <key>NSBluetoothAlwaysUsageDescription</key>
    <string>Glowgrid connects to your LED status panel over Bluetooth.</string>

    <!--
        Calendar access, requested only if you switch the calendar option on.

        Both keys are present deliberately. macOS 14 split calendar permission
        into full and write-only access and introduced the FullAccess key;
        macOS 13 only knows the older one. Ship both and each version finds
        the string it looks for.
    -->
    <key>NSCalendarsFullAccessUsageDescription</key>
    <string>Glowgrid checks whether you are currently in a meeting so the panel can show it. Nothing leaves your Mac.</string>

    <key>NSCalendarsUsageDescription</key>
    <string>Glowgrid checks whether you are currently in a meeting so the panel can show it. Nothing leaves your Mac.</string>
</dict>
</plist>
